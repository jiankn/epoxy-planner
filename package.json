  "type": "module",
  "exports": "./src/index.js",
  "bin": { "epoxy-planner": "./bin/epoxy-planner.js" },
  "files": ["src", "bin", "examples", "README.md", "LICENSE"],
  "engines": { "node": ">=20" },
  "license": "MIT",
  "homepage": "https://epoxyplanner.com/epoxy-calculator/",
  "repository": { "type": "git", "url": "git+https://github.com/jiankn/epoxy-planner.git" },
  "bugs": { "url": "https://github.com/jiankn/epoxy-planner/issues" },
  "keywords": ["epoxy", "resin", "volume", "fabrication", "river-table", "calculator", "cli"],
  "scripts": {
    "test": "node --test",
